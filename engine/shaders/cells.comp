#version 460
//! each cell of the view lists the points of light that reach it (render/cells.zig): one invocation a word of a cell's list, testing its 32 lights' spheres of reach against the cell's planes.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#include "lighting.glsl"

layout(local_size_x = 64) in;
// the frame's lighting record
layout(push_constant) uniform Push { uvec2 light; } pc;
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer CellsOut { uint bits[]; };
// how much further than its reach a light is held to reach, and a hair
// more (world units): a point on a cell's very edge, placed in it by
// `cellAt` by a float's breadth, still finds every light that touches it
const float REACH_MORE = 1.001;
const float REACH_HAIR = 0.001;

void main() {
  Lighting L = Lighting(pc.light);
  int count = lightCount(L);
  int words = lightWords(count);
  int at = int(gl_GlobalInvocationID.x);
  if (words == 0 || at >= CELLS * words) return;
  int cell = at / words, w = at - cell * words;
  // where the cell lies: its tile across the screen, its slice of depth
  int tx = cell % CELLS_X, ty = (cell / CELLS_X) % CELLS_Y, s = cell / (CELLS_X * CELLS_Y);
  // the eye's clip space's rows, as planes in the world: x, y and depth (w)
  mat4 G = L.grid;
  vec4 r0 = vec4(G[0][0], G[1][0], G[2][0], G[3][0]);
  vec4 r1 = vec4(G[0][1], G[1][1], G[2][1], G[3][1]);
  vec4 r3 = vec4(G[0][3], G[1][3], G[2][3], G[3][3]);
  // the tile's edges across the screen (-1 .. 1)
  vec2 lo = vec2(tx, ty) / vec2(CELLS_X, CELLS_Y) * 2.0 - 1.0;
  vec2 hi = vec2(tx + 1, ty + 1) / vec2(CELLS_X, CELLS_Y) * 2.0 - 1.0;
  // the cell's planes, each facing in: its four sides through the eye, and
  // (a slice, not a tile's whole depth) its near and far faces
  vec4 planes[6];
  planes[0] = r0 - lo.x * r3;
  planes[1] = hi.x * r3 - r0;
  planes[2] = r1 - lo.y * r3;
  planes[3] = hi.y * r3 - r1;
  int sides = 4;
  if (s < SLICES) {
    vec2 span = sliceSpan(L, s);
    planes[4] = r3 - vec4(0.0, 0.0, 0.0, span.x);
    sides = 5;
    if (span.y >= 0.0) { planes[5] = vec4(0.0, 0.0, 0.0, span.y) - r3; sides = 6; }
  }
  for (int k = 0; k < sides; k++) planes[k] /= length(planes[k].xyz);
  // a bit for each light whose sphere of reach is inside every plane
  uint bits = 0u;
  int first = w * 32;
  int n = min(count - first, 32);
  for (int b = 0; b < n; b++) {
    vec4 lp = L.lights[first + b].pos;
    float r = lp.w * REACH_MORE + REACH_HAIR;
    bool in_ = true;
    for (int k = 0; k < sides; k++) in_ = in_ && dot(planes[k].xyz, lp.xyz) + planes[k].w >= -r;
    if (in_) bits |= 1u << uint(b);
  }
  CellsOut(L.cells).bits[at] = bits;
}
